# Transport recovered from the site's own wp-mail-smtp configuration
# (smtp.gmail.com:587, STARTTLS). The shared sending account is used, the same
# one the other migrated sites use; WordPress forced the From address, so the
# From name is kept per-site.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=info@floridabasketballjerseys.com
MAIL_FROM_NAME=Florida Basktetball Jerseys

# Recipients, exactly as the WordPress forms were configured:
#   wp_mail_smtp / Lead Form snippet -> quotes@example.invalid
#   Elementor "Instant Quote" 2nd action -> orders@example.invalid
QUOTE_TO=quotes@example.invalid, orders@example.invalid
CONTACT_TO=quotes@example.invalid, orders@example.invalid
