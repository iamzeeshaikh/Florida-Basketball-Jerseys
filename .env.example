# Transport recovered from the site's own wp-mail-smtp configuration
# (smtp.gmail.com:587, STARTTLS). The shared sending account is used, the same
# one the other migrated sites use; WordPress forced the From address, so the
# From name is kept per-site.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=info@floridabasketballjerseys.com
MAIL_FROM_NAME=Florida Basktetball Jerseys

# Where enquiries go. Comma-separated. Both were taken from the WordPress
# install (wp_mail_smtp plus the Elementor form's two email actions); the real
# values live in .env and in the Vercel project, not here.
QUOTE_TO=
CONTACT_TO=
