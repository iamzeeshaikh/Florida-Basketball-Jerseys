---
import pages from '../data/pages.json';
import { rewrite, dropFontImports } from '../lib/site.js';
import { applyProductContent, polishPage } from '../lib/product-sections.js';
import { extractFaqs, faqSchema, breadcrumbSchema, pageTitleFrom, schemaTags } from '../lib/schema.js';
import Shell from '../layouts/Shell.astro';

export function getStaticPaths() {
  // 404 is emitted by src/pages/404.astro so the host can serve it as the
  // error document rather than as a route of its own
  return Object.values(pages).filter((page) => page.slug !== '404').map((page) => ({
    // Astro's rest param wants the path without leading/trailing slashes;
    // trailingSlash: 'always' + build.format 'directory' put them back.
    params: { path: page.route === '/' ? undefined : page.route.slice(1, -1) },
    props: { page },
  }));
}

const { page } = Astro.props;

// Product pages get their five shared sections filled in with content about the
// product actually being sold — see src/lib/product-sections.js for what was
// wrong with them. Every other route passes through untouched.
const productSlug = page.route.startsWith('/product/')
  ? page.route.replace('/product/', '').replace(/\/$/, '')
  : null;
// Product pages get their sections filled as well; every other page still gets
// the site-wide corrections — the dead product link and the British spellings
// appear on category, policy and landing pages too.
const html = productSlug ? applyProductContent(page.content, productSlug) : polishPage(page.content);

// Structured data is derived from the FINISHED html, after the sections have
// been filled — so the markup describes the page that is actually served
// rather than the captured original. 629 questions across the catalogue were
// visible to readers and invisible to search; see src/lib/schema.js.
const faqs = extractFaqs(html);
const jsonLd = schemaTags([
  faqSchema(faqs),
  breadcrumbSchema(page.route, pageTitleFrom(html)),
]);
---
<Shell page={page}>
  <Fragment set:html={dropFontImports(rewrite(html))} />
  {jsonLd && <Fragment set:html={jsonLd} />}
</Shell>
