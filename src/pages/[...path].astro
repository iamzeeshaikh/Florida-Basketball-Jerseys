---
import pages from '../data/pages.json';
import { rewrite, dropFontImports, dropEntranceAnimations } from '../lib/site.js';
import { applyProductContent, polishPage, splitForDesigner } from '../lib/product-sections.js';
import { addDescriptionTab } from '../lib/product-description.js';
import { extractFaqs, faqSchema, breadcrumbSchema, pageTitleFrom, schemaTags } from '../lib/schema.js';
import { enhanceImages } from '../lib/images.js';
import Shell from '../layouts/Shell.astro';
import QuickQuote from '../components/QuickQuote.astro';
import JerseyDesigner from '../components/JerseyDesigner.astro';

export function getStaticPaths() {
  // 404 is emitted by src/pages/404.astro so the host can serve it as the
  // error document rather than as a route of its own
  return Object.values(pages).filter((page) => page.slug !== '404').map((page) => ({
    // Astro's rest param wants the path without leading/trailing slashes;
    // trailingSlash: 'always' + build.format 'directory' put them back.
    params: { path: page.route === '/' ? undefined : page.route.slice(1, -1) },
    props: { page },
  }));
}

const { page } = Astro.props;

// Product pages get their five shared sections filled in with content about the
// product actually being sold — see src/lib/product-sections.js for what was
// wrong with them. Every other route passes through untouched.
const productSlug = page.route.startsWith('/product/')
  ? page.route.replace('/product/', '').replace(/\/$/, '')
  : null;
// Product pages get their sections filled as well; every other page still gets
// the site-wide corrections — the dead product link and the British spellings
// appear on category, policy and landing pages too.
// The Description tab, first among the product tabs. The migrated template
// ships Specifications and Faqs and no prose; see src/lib/product-description.js.
const html = dropEntranceAnimations(enhanceImages(
  productSlug
    ? addDescriptionTab(applyProductContent(page.content, productSlug), productSlug)
    : polishPage(page.content),
));

// Structured data is derived from the FINISHED html, after the sections have
// been filled — so the markup describes the page that is actually served
// rather than the captured original. 629 questions across the catalogue were
// visible to readers and invisible to search; see src/lib/schema.js.
// The short quote form opens every product and category page, before the
// gallery and before the listing. The existing Elementor form stays where it
// is further down — this one is for the visitor who arrived knowing what they
// want and does not intend to scroll.
const isCategory = page.route.startsWith('/product-category/') && !page.route.includes('/page/');
const showQuickQuote = Boolean(productSlug) || isCategory;
const pageTitle = pageTitleFrom(html);

// The designer goes on the product page itself, not only on its own page: the
// visitor closest to ordering was the one with no way to see what they were
// choosing. splitForDesigner refuses to cut if the halves would not balance,
// in which case the page renders exactly as before and the tool is simply not
// there — a missing section beats a torn one.
const [beforeDesigner, afterDesigner] = productSlug ? splitForDesigner(dropFontImports(rewrite(html))) : [null, null];

// Open the designer on the garment the page is about. "Shorts" and "uniform"
// are the only two the catalogue distinguishes; everything else is a jersey.
const designerGarment = /shorts/i.test(productSlug ?? '') ? 'Shorts'
  : /uniform|full-set/i.test(productSlug ?? '') ? 'Full uniform set'
  : 'Jersey';

const faqs = extractFaqs(html);
const jsonLd = schemaTags([
  faqSchema(faqs),
  breadcrumbSchema(page.route, pageTitleFrom(html)),
]);
---
<Shell page={page}>
  {showQuickQuote && <QuickQuote productName={pageTitle} pageTitle={page.head.match(/<title>([\s\S]*?)<\/title>/)?.[1] ?? pageTitle} />}
  {productSlug && afterDesigner ? (
    <>
      <Fragment set:html={beforeDesigner} />
      <section class="fbj-dz fbj-dz--embedded">
        <div class="fbj-dz-inner">
          <JerseyDesigner
            embedded
            garment={designerGarment}
            productName={pageTitle}
            refererTitle={page.head.match(/<title>([\s\S]*?)<\/title>/)?.[1] ?? pageTitle}
          />
        </div>
      </section>
      <Fragment set:html={afterDesigner} />
    </>
  ) : (
    <Fragment set:html={productSlug ? beforeDesigner : dropFontImports(rewrite(html))} />
  )}
  {jsonLd && <Fragment set:html={jsonLd} />}
</Shell>
