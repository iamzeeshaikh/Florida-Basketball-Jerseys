---
// A jersey designer that produces a SPEC, not a mockup.
//
// The preview exists to make choices concrete — you can see a contrast panel
// against a base color and decide you do not like it. What it deliberately
// does not do is promise the color you see. Screens build color from light and
// fabric builds it from dye, and the two disagree most on exactly the colors
// teams choose; the page says so plainly next to the preview rather than
// leaving somebody to discover it on delivery.
//
// Submitting sends the spec to the same /api/quote endpoint every other form
// on the site uses, so it lands with the same people in the same format.
import Shell from '../layouts/Shell.astro';
import { makePage } from '../lib/newpage.js';
import { breadcrumbSchema, faqSchema, schemaTags } from '../lib/schema.js';
import JerseyDesigner from '../components/JerseyDesigner.astro';

const route = '/design-your-jersey/';
const page = makePage({
  route,
  title: 'Design Your Own Basketball Jersey | Free Online Jersey Designer',
  description:
    'Build your team jersey — colors, panel style, neckline, team name and numbers — see it as you go, then send the spec for a free quote. No minimum order.',
  styles: ['/assets/fbj-designer.css'],
});


const faqs = [
  { q: 'Is the color I see here the color I will get?', a: 'Not exactly, and we would rather say so here than on delivery. A screen makes color by adding light and fabric makes it by absorbing it, and the two ranges do not fully overlap — purple and orange sit furthest apart. Use the preview to decide layout and contrast, then send us a Pantone value or a physical sample for the actual color, and we match to that.' },
  { q: 'Do I have to finish the design to get a quote?', a: 'No. Send whatever you have — even just the garment and a rough color direction. Our design team finishes it from there at no charge, and you approve a digital proof before anything is printed.' },
  { q: 'Can I upload our existing logo?', a: 'Yes, on the quote form. A vector file is best because it scales to a full chest without softening. If you only have an image we redraw it as vector at no charge rather than printing a soft one.' },
  { q: 'Does a more complicated design cost more?', a: 'No. The whole design is printed in one pass rather than one screen per color, so colors, gradients and panel styles do not change the price. What sets the price is the garment.' },
];

const jsonLd = schemaTags([faqSchema(faqs), breadcrumbSchema(route, 'Design Your Jersey')]);
---
<Shell page={page}>
  <div class="fbj-dz">

    <header class="fbj-dz-head">
      <div class="fbj-dz-inner">
        <div class="fbj-dz-kicker">Free jersey designer</div>
        <h1 class="fbj-dz-h1">Design Your <span>Team Jersey</span></h1>
        <p class="fbj-dz-lede">
          Pick the garment, the colors, the panel style and the lettering, and watch it come together.
          When it looks right, send the spec — our design team finishes it and you approve a proof
          before anything is printed. <strong>Design and proofing are free.</strong>
        </p>
      </div>
    </header>

    <div class="fbj-dz-inner">
      <JerseyDesigner />

      <section style="padding: 30px 0 56px;">
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;text-transform:uppercase;font-size:30px;margin:0 0 18px;">Questions</h2>
        {faqs.map((f) => (
          <div style="border-top:1px solid #E2E8F0;padding:18px 0;">
            <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:20px;margin:0 0 8px;">{f.q}</h3>
            <p style="margin:0;font-size:15.5px;line-height:1.68;color:#46586B;max-width:76ch;">{f.a}</p>
          </div>
        ))}
      </section>
    </div>
  </div>
  <Fragment set:html={jsonLd} />
</Shell>
