---
// The page shell captured from WordPress: head, body classes, Elementor header
// and footer, and the trailing vendor scripts. `[...path].astro` renders the
// migrated pages with it; the cart-flow pages WordPress never served as HTML
// borrow a captured record so they inherit identical chrome.
import { rewrite, dropFontImports, trimUnusedFonts } from '../lib/site.js';
import { ASSET_VERSION } from '../lib/assets.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { page } = Astro.props;
const isProduct = page.route.startsWith('/product/') && page.route !== '/product/' && !page.route.includes('/page/');
// The quick-quote strip opens product and category pages.
const hasQuickQuote = isProduct
  || (page.route.startsWith('/product-category/') && !page.route.includes('/page/'));
---
<!DOCTYPE html>
<html lang="en-US">
<head>
<Fragment set:html={trimUnusedFonts(dropFontImports(rewrite(page.head)))} />
{/* Self-hosted (scripts/build-fonts.py). These were fetched from Google on
    every page load — two DNS lookups and two TLS handshakes before the first
    glyph exists — and the hero reflowed when they arrived. Same origin now,
    and the paths are stable, so the faces that paint above the fold can be
    preloaded. */}
<link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/dm-sans-400-latin.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/barlow-condensed-800-latin.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/source-sans-pro-400-latin.woff2" />
<link rel="stylesheet" href={`/assets/fbj-fonts.css?v=${ASSET_VERSION}`} />
{/* Header and footer CSS, previously inlined on all 76 pages. */}
<link rel="stylesheet" href={`/assets/fbj-chrome.css?v=${ASSET_VERSION}`} />
{/* The five product sections inlined 56,851 bytes of identical CSS on each of
    the 42 product pages. It is one cached file now. */}
{isProduct && <link rel="stylesheet" href={`/assets/product-sections.css?v=${ASSET_VERSION}`} />}
{/* The jersey designer is on every product page now, not only its own. */}
{isProduct && <link rel="stylesheet" href={`/assets/fbj-designer.css?v=${ASSET_VERSION}`} />}
{isProduct && <link rel="stylesheet" href={`/assets/fbj-product-description.css?v=${ASSET_VERSION}`} />}
{hasQuickQuote && <link rel="stylesheet" href={`/assets/fbj-quickquote.css?v=${ASSET_VERSION}`} />}
{(page.styles ?? []).map((href) => <link rel="stylesheet" href={`${href}?v=${ASSET_VERSION}`} />)}
</head>

<body class={page.bodyClass}>
		<Header page={page} />
		<slot />
		<Footer page={page} />
<Fragment set:html={dropFontImports(rewrite(page.tail))} />
<script src={`/assets/fbj.js?v=${ASSET_VERSION}`} data-v={ASSET_VERSION} defer></script>
<script src={`/assets/cart.js?v=${ASSET_VERSION}`} data-v={ASSET_VERSION} defer></script>
</body>
</html>
