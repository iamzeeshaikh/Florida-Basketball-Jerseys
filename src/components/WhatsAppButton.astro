---
// Floating WhatsApp button.
//
// BOTTOM-LEFT on purpose: the ZeeOps chat widget sits bottom-right on every one
// of these sites, and two round buttons in the same corner overlap on a phone.
//
// The message is prefilled with what this site sells, so the enquiry arrives
// already saying which brand it is about — one WhatsApp number serves all five
// sports sites, and nothing else in the message would tell them apart.
const { text } = Astro.props as { text: string }
const NUMBER = '12134493746'
// The site URL rides in every prefill — one number serves every sports site,
// and this is how the CRM tells which site the customer came from.
const href = `https://wa.me/${NUMBER}?text=${encodeURIComponent(text.includes('floridabasketballjerseys.com') ? text : `${text} https://floridabasketballjerseys.com/`)}`
---
<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Chat with us on WhatsApp"
  class="zee-wa-btn"
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
  </svg>
</a>

<style>
  .zee-wa-btn {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 2147483000;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, .25);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .zee-wa-btn:hover { transform: scale(1.06); box-shadow: 0 8px 26px rgba(0, 0, 0, .3); }
  .zee-wa-btn:focus-visible { outline: 3px solid #0b5; outline-offset: 3px; }
  /* Phones: a little smaller, and clear of the browser's own bottom bar. */
  @media (max-width: 640px) {
    .zee-wa-btn { width: 50px; height: 50px; left: 14px; bottom: 14px; }
    .zee-wa-btn svg { width: 25px; height: 25px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .zee-wa-btn, .zee-wa-btn:hover { transition: none; transform: none; }
  }
</style>
